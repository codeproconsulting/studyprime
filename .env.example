# WordPress Headless CMS Configuration
# Replace with your live WordPress URL (without trailing slash), e.g., https://cms.studyprime.pk
WORDPRESS_URL=https://cms.studyprime.pk

# Assessment & Consultation Form Webhook (Optional)
# If provided, every student consultation booking is automatically posted to your Google Sheet or WordPress
# Google Apps Script Web App URL:
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Or WordPress Custom REST Lead Endpoint / Webhook:
# WORDPRESS_LEAD_WEBHOOK_URL=https://cms.studyprime.pk/wp-json/studyprime/v1/lead
